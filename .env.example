# Copy to .env and fill in what you need. Everything here is optional —
# the server boots and reads a live room without any of it.

# Port the server (dashboard + overlays + API) listens on.
PORT=4700

# Which interfaces to listen on. The default, 0.0.0.0, means anyone on your
# LAN (or on a VPN adapter like Hamachi) can reach the dashboard. Set this to
# 127.0.0.1 when your capture software runs on this machine — then nothing
# off-machine can connect at all, which is stronger than any password.
HOST=0.0.0.0

# --- Dashboard password -----------------------------------------------------
# Locks the dashboard and every state-changing API call behind a login.
# Leave blank to require no password.
#
# Overlay browser sources keep working either way: OBS cannot log in, so
# /overlay/<id> and the handful of routes it needs stay open by design. That
# means a password protects control, not the event stream — bind HOST to
# 127.0.0.1 as well if you want both closed.
DASHBOARD_PASSWORD=

# --- TikTok LIVE connection -------------------------------------------------
# Euler Stream key used to sign the webcast WebSocket URL. Without one the
# connector shares a rate-limited public quota, which is fine for testing but
# starts failing under load. Free key: https://www.eulerstream.com
SIGN_API_KEY=

# --- TikTok TTS -------------------------------------------------------------
# The `sessionid` cookie from tiktok.com while logged in. Required for the
# TikTok voices; without it, TTS falls back to browser speech synthesis.
#
# To get it: log in to tiktok.com, open DevTools > Application > Cookies,
# copy the value of `sessionid`. Treat it like a password — it authenticates
# as your account. Keep it here rather than in the dashboard if you ever
# expose the dashboard through the tunnel.
TIKTOK_SESSION_ID=

# Data centre your account belongs to. Only matters alongside a session id.
TIKTOK_TARGET_IDC=useast2a

# --- Google Cloud TTS (the other speech backend) ----------------------------
# An API key with the Text-to-Speech API enabled. The free tier covers 4M
# characters/month on Standard voices and 1M on Neural2 — far more than a
# stream reads aloud, so this normally costs nothing.
#
# 1. console.cloud.google.com -> create or pick a project
# 2. Enable "Cloud Text-to-Speech API"
# 3. APIs & Services -> Credentials -> Create credentials -> API key
# 4. Restrict the key to the Text-to-Speech API (important — an unrestricted
#    key is usable for anything on the project if it ever leaks)
GOOGLE_TTS_API_KEY=

# --- Public tunnel ----------------------------------------------------------
# Needed only if you want overlay URLs reachable from another machine.
# Free token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Platform sign-in (OAuth applications)
#
# These identify the APPLICATION, not you — you sign in on the provider's own
# site and this server only ever sees the short-lived code they hand back.
# User tokens are stored separately in data/credentials.json, never here and
# never in config.json (which is broadcast to every connected client).
#
# Twitch — register at https://dev.twitch.tv/console/apps
#   OAuth Redirect URL: http://localhost:4700/api/auth/twitch/callback
#   The client id/secret ALONE unlock chat avatars, with no sign-in at all.
#   Signing in additionally enables sending messages and moderating.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube — Google Cloud Console, enable "YouTube Data API v3",
# create an OAuth 2.0 Client ID of type "Web application".
#   Authorized redirect URI: http://localhost:4700/api/auth/youtube/callback
#   YouTube live chat CANNOT be read without signing in: the API requires the
#   request to be authorized by the account that owns the broadcast.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
